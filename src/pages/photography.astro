---
import Layout from "../layouts/Layout.astro";
import { cachedUnsplashPhotos } from "../unsplash";

const UNSPLASH_USERNAME = "chanakan5591_";

let photos: any[] = [];
let fetchError: string | null = null;

try {
  photos = await cachedUnsplashPhotos(UNSPLASH_USERNAME, 30);
} catch (e) {
  fetchError = e instanceof Error ? e.message : "Failed to fetch photos";
  console.error("Unsplash fetch error:", e);
}

// Stats
const totalLikes = photos.reduce((sum: number, p: any) => sum + (p.likes || 0), 0);
const totalDownloads = photos.reduce((sum: number, p: any) => sum + (p.downloads || 0), 0);
const cameras = [...new Set(photos.filter((p: any) => p.exif?.make).map((p: any) => `${p.exif.make} ${p.exif.model || ''}`))];

const col1 = photos.filter((_: any, i: number) => i % 2 === 0);
const col2 = photos.filter((_: any, i: number) => i % 2 !== 0);

function formatISO(iso: number | null) {
  return iso ? `ISO ${iso}` : null;
}
---

<Layout>
  <main class="min-h-screen w-full bg-[#0f0f0f] text-off-white">
    <div class="max-w-[1600px] mx-auto border-x border-white/8">
      
      <!-- Header Section -->
      <header class="grid grid-cols-1 md:grid-cols-12 border-b border-white/8">
        <div class="md:col-span-8 p-4 md:p-8 lg:p-12 border-b md:border-b-0 md:border-r border-white/8 flex flex-col justify-between min-h-[40vh]">
          <div>
             <a href="/" class="inline-block mb-8 text-sm uppercase tracking-widest text-white/40 hover:text-accent-amber transition-colors">← Back to Index</a>
             <h1 class="font-headline text-6xl md:text-8xl leading-[0.9] tracking-tight">
              Visual<br/>
              <span class="text-accent-amber italic">Diaries</span>
            </h1>
          </div>
          <p class="max-w-md mt-8 text-lg md:text-xl font-headline leading-relaxed text-white/70">
            Personal photography shot on digital and film, color-graded to feel like cinema stills. The palette borrows from Blade Runner 2049, the natural light of Nomadland, and the quiet framing of In the Mood for Love.
          </p>
        </div>
        
        <!-- Sidebar Info -->
        <div class="md:col-span-4 p-4 md:p-8 flex flex-col justify-between bg-white/[0.02]">
           <div class="space-y-6">
              <div>
                <span class="block text-xs uppercase tracking-widest mb-2 text-accent-amber/60">Primary Camera</span>
                <p class="font-headline text-lg">Fujifilm X-A1</p>
                <p class="text-sm text-white/40 mt-1">Fujinon XF 23mm F/2</p>
              </div>
              <div>
                <span class="block text-xs uppercase tracking-widest mb-2 text-accent-amber/60">Film</span>
                <p class="text-sm text-white/50 leading-relaxed">Also shoots on various film cameras. The grain is the point.</p>
              </div>
              <div>
                <span class="block text-xs uppercase tracking-widest mb-2 text-accent-amber/60">Style</span>
                <p class="text-sm text-white/50 leading-relaxed">Cinema stills with deliberate color and atmospheric mood. Somewhere between the amber haze of Deakins, the neon glow Khondji brings, and the quiet intimacy of Christopher Doyle.</p>
              </div>
              {cameras.length > 0 && (
                <div>
                  <span class="block text-xs uppercase tracking-widest mb-2 text-accent-amber/60">Cameras Used</span>
                  <div class="flex flex-wrap gap-1.5">
                    {cameras.map((cam: string) => (
                      <span class="text-[10px] px-2 py-0.5 border border-white/10 rounded-full text-white/40">{cam}</span>
                    ))}
                  </div>
                </div>
              )}
           </div>
           <div class="mt-12 flex items-center justify-between">
              <div>
                <span class="block text-xs uppercase tracking-widest mb-2 text-white/30">Status</span>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-amber-400/60"></span>
                  <span class="text-sm text-white/50">Hobbyist, not for hire</span>
                </div>
              </div>
              <div class="text-right">
                <span class="block text-xs uppercase tracking-widest mb-2 text-white/30">Source</span>
                <a href={`https://unsplash.com/@${UNSPLASH_USERNAME}`} target="_blank" rel="noopener noreferrer" class="text-sm text-accent-amber/60 hover:text-accent-amber transition-colors">
                  @{UNSPLASH_USERNAME} ↗
                </a>
              </div>
           </div>
        </div>
      </header>

      <!-- Stats Bar -->
      {photos.length > 0 && (
        <div class="grid grid-cols-3 border-b border-white/8 divide-x divide-white/8">
          <div class="p-4 md:p-6 text-center">
            <div class="text-2xl md:text-3xl font-headline text-accent-amber">{photos.length}</div>
            <div class="text-[10px] uppercase tracking-widest text-white/30 mt-1">Photos</div>
          </div>
          <div class="p-4 md:p-6 text-center">
            <div class="text-2xl md:text-3xl font-headline text-accent-amber">{totalLikes}</div>
            <div class="text-[10px] uppercase tracking-widest text-white/30 mt-1">Likes</div>
          </div>
          <div class="p-4 md:p-6 text-center">
            <div class="text-2xl md:text-3xl font-headline text-accent-amber">{cameras.length}</div>
            <div class="text-[10px] uppercase tracking-widest text-white/30 mt-1">Cameras</div>
          </div>
        </div>
      )}

      {fetchError && (
        <div class="p-8 text-center border-b border-white/8">
          <p class="text-accent-amber text-sm">{fetchError}</p>
          <p class="text-white/30 text-xs mt-2">Unsplash API may be temporarily unavailable.</p>
        </div>
      )}

      {photos.length === 0 && !fetchError && (
        <div class="p-12 text-center border-b border-white/8">
          <p class="font-headline text-2xl text-white/40">No photos found on Unsplash yet.</p>
        </div>
      )}

      <!-- Gallery Grid — Masonry-style two columns -->
      <div class="flex flex-col md:flex-row">
        <!-- Left Column -->
        <div class="w-full md:w-1/2 md:border-r border-white/8 flex flex-col">
          {col1.map((photo: any, idx: number) => (
            <a
              href={photo.links?.html || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="group border-b border-white/8 block"
            >
              <!-- Frame number strip -->
              <div class="flex items-center justify-between px-3 md:px-6 pt-3 md:pt-4 pb-2">
                <span class="text-[10px] font-mono text-white/35 tracking-widest">
                  FRAME {String(idx * 2 + 1).padStart(3, '0')}
                </span>
                <span class="text-[10px] font-mono text-white/35">
                  {photo.width}×{photo.height}
                </span>
              </div>

              <!-- Photo with native aspect ratio -->
              <div class="px-3 md:px-6">
                <div class="overflow-hidden relative bg-black/50 rounded-sm">
                  <img 
                    src={photo.urls.regular}
                    alt={photo.alt_description || photo.description || 'Photograph'}
                    width={photo.width}
                    height={photo.height}
                    class="w-full h-auto transition-all duration-700 group-hover:scale-[1.03] opacity-90 group-hover:opacity-100"
                    loading="lazy"
                    style={`aspect-ratio: ${photo.width}/${photo.height};`}
                  />
                  <!-- Film grain overlay -->
                  <div class="absolute inset-0 pointer-events-none opacity-[0.06] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
                </div>
              </div>

              <!-- Photo Info -->
              <div class="px-3 md:px-6 py-4 md:py-5">
                <div class="flex justify-between items-start mb-3">
                  <div class="flex-1 min-w-0 pr-4">
                    {photo.location?.name && (
                      <span class="text-[10px] uppercase tracking-widest text-accent-amber/60 mb-1 block">{photo.location.name}</span>
                    )}
                    <h3 class="font-headline text-lg text-white/80 group-hover:text-accent-amber transition-colors leading-tight">
                      {photo.alt_description || photo.description || 'Untitled'}
                    </h3>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <span class="text-xs font-mono text-white/25 block">
                      {new Date(photo.created_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                    </span>
                  </div>
                </div>

                <!-- Color palette from photo -->
                {photo.color && (
                  <div class="flex items-center gap-2 mb-3">
                    <div class="w-4 h-4 rounded-full border border-white/10" style={`background-color: ${photo.color};`}></div>
                    <span class="text-[10px] font-mono text-white/40 uppercase">{photo.color}</span>
                  </div>
                )}
                
                <!-- EXIF data bar -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-[11px] border-t border-white/6 pt-3 text-white/30 group-hover:text-white/50 transition-colors duration-300">
                  {photo.exif?.make && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/35 text-[9px] mb-0.5">Camera</span>
                      <span>{photo.exif.make} {photo.exif.model || ''}</span>
                    </div>
                  )}
                  {photo.exif?.focal_length && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/35 text-[9px] mb-0.5">Focal</span>
                      <span>{photo.exif.focal_length}mm</span>
                    </div>
                  )}
                  {photo.exif?.aperture && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/35 text-[9px] mb-0.5">Aperture</span>
                      <span>ƒ/{photo.exif.aperture}</span>
                    </div>
                  )}
                  {photo.exif?.exposure_time && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/35 text-[9px] mb-0.5">Shutter</span>
                      <span>{photo.exif.exposure_time}s</span>
                    </div>
                  )}
                  {photo.exif?.iso && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/35 text-[9px] mb-0.5">ISO</span>
                      <span>{photo.exif.iso}</span>
                    </div>
                  )}
                </div>

                <!-- Engagement row -->
                <div class="flex items-center gap-4 mt-3 pt-3 border-t border-white/6 text-[10px] text-white/40">
                  {photo.likes > 0 && (
                    <span class="flex items-center gap-1">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      {photo.likes}
                    </span>
                  )}
                  <span class="flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    {photo.width}×{photo.height}
                  </span>
                  <span class="ml-auto uppercase tracking-widest text-accent-amber/60 group-hover:text-accent-amber/70 transition-colors">
                    View on Unsplash ↗
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Right Column -->
        <div class="w-full md:w-1/2 flex flex-col">
          {col2.map((photo: any, idx: number) => (
            <a
              href={photo.links?.html || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="group border-b border-white/8 block"
            >
              <div class="flex items-center justify-between px-3 md:px-6 pt-3 md:pt-4 pb-2">
                <span class="text-[10px] font-mono text-white/35 tracking-widest">
                  FRAME {String(idx * 2 + 2).padStart(3, '0')}
                </span>
                <span class="text-[10px] font-mono text-white/35">
                  {photo.width}×{photo.height}
                </span>
              </div>

              <div class="px-3 md:px-6">
                <div class="overflow-hidden relative bg-black/50 rounded-sm">
                  <img 
                    src={photo.urls.regular}
                    alt={photo.alt_description || photo.description || 'Photograph'}
                    width={photo.width}
                    height={photo.height}
                    class="w-full h-auto transition-all duration-700 group-hover:scale-[1.03] opacity-90 group-hover:opacity-100"
                    loading="lazy"
                    style={`aspect-ratio: ${photo.width}/${photo.height};`}
                  />
                  <div class="absolute inset-0 pointer-events-none opacity-[0.06] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
                </div>
              </div>

              <div class="px-3 md:px-6 py-4 md:py-5">
                <div class="flex justify-between items-start mb-3">
                  <div class="flex-1 min-w-0 pr-4">
                    {photo.location?.name && (
                      <span class="text-[10px] uppercase tracking-widest text-accent-amber/60 mb-1 block">{photo.location.name}</span>
                    )}
                    <h3 class="font-headline text-lg text-white/80 group-hover:text-accent-amber transition-colors leading-tight">
                      {photo.alt_description || photo.description || 'Untitled'}
                    </h3>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <span class="text-xs font-mono text-white/25 block">
                      {new Date(photo.created_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                    </span>
                  </div>
                </div>

                {photo.color && (
                  <div class="flex items-center gap-2 mb-3">
                    <div class="w-4 h-4 rounded-full border border-white/10" style={`background-color: ${photo.color};`}></div>
                    <span class="text-[10px] font-mono text-white/20 uppercase">{photo.color}</span>
                  </div>
                )}

                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-[11px] border-t border-white/6 pt-3 text-white/30 group-hover:text-white/50 transition-colors duration-300">
                  {photo.exif?.make && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/15 text-[9px] mb-0.5">Camera</span>
                      <span>{photo.exif.make} {photo.exif.model || ''}</span>
                    </div>
                  )}
                  {photo.exif?.focal_length && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/15 text-[9px] mb-0.5">Focal</span>
                      <span>{photo.exif.focal_length}mm</span>
                    </div>
                  )}
                  {photo.exif?.aperture && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/15 text-[9px] mb-0.5">Aperture</span>
                      <span>ƒ/{photo.exif.aperture}</span>
                    </div>
                  )}
                  {photo.exif?.exposure_time && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/15 text-[9px] mb-0.5">Shutter</span>
                      <span>{photo.exif.exposure_time}s</span>
                    </div>
                  )}
                  {photo.exif?.iso && (
                    <div>
                      <span class="uppercase tracking-widest block text-white/15 text-[9px] mb-0.5">ISO</span>
                      <span>{photo.exif.iso}</span>
                    </div>
                  )}
                </div>

                <div class="flex items-center gap-4 mt-3 pt-3 border-t border-white/6 text-[10px] text-white/20">
                  {photo.likes > 0 && (
                    <span class="flex items-center gap-1">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      {photo.likes}
                    </span>
                  )}
                  <span class="flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    {photo.width}×{photo.height}
                  </span>
                  <span class="ml-auto uppercase tracking-widest text-accent-amber/40 group-hover:text-accent-amber/70 transition-colors">
                    View on Unsplash ↗
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Cinematography Philosophy -->
      <section class="border-b border-white/8 p-8 md:p-14 lg:p-20 bg-white/[0.02]">
        <div class="max-w-3xl mx-auto text-center space-y-6">
          <div class="text-[10px] font-mono uppercase tracking-[0.3em] text-white/25 flex items-center justify-center gap-4">
            <span class="w-8 h-px bg-white/10"></span>
            On Visual Storytelling
            <span class="w-8 h-px bg-white/10"></span>
          </div>
          <blockquote class="font-headline text-xl md:text-3xl leading-relaxed text-white/70 italic">
            Every frame is a painting. The camera doesn't just capture; it interprets. There's the golden-hour realism of Terrence Malick, the urban poetry of Wong Kar-wai, and the stark geometry of Kubrick. That's the vocabulary I try to shoot in.
          </blockquote>
          <div class="flex flex-wrap justify-center gap-3 pt-4">
            <span class="text-[10px] px-3 py-1 border border-white/10 rounded-full text-accent-amber/50">Blade Runner 2049 · Roger Deakins</span>
            <span class="text-[10px] px-3 py-1 border border-white/10 rounded-full text-accent-amber/50">In the Mood for Love · Christopher Doyle</span>
            <span class="text-[10px] px-3 py-1 border border-white/10 rounded-full text-accent-amber/50">Nomadland · Joshua James Richards</span>
            <span class="text-[10px] px-3 py-1 border border-white/10 rounded-full text-accent-amber/50">The Grand Budapest Hotel · Robert Yeoman</span>
            <span class="text-[10px] px-3 py-1 border border-white/10 rounded-full text-accent-amber/50">Parasite · Hong Kyung-pyo</span>
            <span class="text-[10px] px-3 py-1 border border-white/10 rounded-full text-accent-amber/50">Amélie · Bruno Delbonnel</span>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="p-4 md:p-8 flex justify-between items-center text-white/30">
        <span class="font-headline text-xl text-white/50">Chanakan Moongthin</span>
        <a href="#" class="text-sm uppercase tracking-widest hover:text-accent-amber transition-colors">Back to Top ↑</a>
      </footer>

    </div>
  </main>
</Layout>
